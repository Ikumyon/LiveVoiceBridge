class Measurement:
    @property
    def value(self) -> float | None: ...
    @property
    def state(self) -> str: ...

class NativeGpu:
    @property
    def identifier(self) -> str: ...
    @property
    def name(self) -> str: ...
    @property
    def usage(self) -> Measurement: ...
    @property
    def memory_used(self) -> Measurement: ...
    @property
    def memory_total(self) -> Measurement: ...

class NativeMetricsSnapshot:
    @property
    def cpu_percent(self) -> Measurement: ...
    @property
    def ram_percent(self) -> Measurement: ...
    @property
    def ram_used_gb(self) -> Measurement: ...
    @property
    def ram_total_gb(self) -> Measurement: ...
    @property
    def network_send_kbps(self) -> Measurement: ...
    @property
    def network_receive_kbps(self) -> Measurement: ...
    @property
    def gpus(self) -> list[NativeGpu]: ...
    @property
    def active_sockets(self) -> Measurement: ...
    @property
    def npu_percent(self) -> Measurement: ...

class RustMetricsCollector:
    def __init__(self) -> None: ...
    def collect(self) -> NativeMetricsSnapshot: ...
    def close(self) -> None: ...

class AudioClip:
    @staticmethod
    def from_wav(
        wav: bytes, max_bytes: int, echo: int | None = ..., yamabiko: int | None = ..., panning: str | None = ...
    ) -> AudioClip: ...
    @property
    def byte_length(self) -> int: ...
    @property
    def sample_rate(self) -> int: ...
    @property
    def channels(self) -> int: ...

class AudioPlayer:
    def __init__(self, sounds: str) -> None: ...
    def play(self, clip: AudioClip) -> None: ...
    def sound(self, filename: str, overlap: bool) -> None: ...
    def drain_errors(self) -> list[str]: ...
    def close(self) -> None: ...

class ManagedProcess:
    def __init__(self) -> None: ...
    def start(
        self,
        executable: str,
        args: list[str] = ...,
        cwd: str | None = ...,
        env: dict[str, str] | None = ...,
        log: str | None = ...,
    ) -> None: ...
    def is_running(self) -> bool: ...
    def exit_code(self) -> int | None: ...
    def close(self) -> None: ...

class PlatformPaths:
    def __init__(self, source_root: str | None = ...) -> None: ...
    @property
    def root(self) -> str: ...
    @property
    def config(self) -> str: ...
    @property
    def dictionary(self) -> str: ...
    @property
    def sounds(self) -> str: ...
    @property
    def executable_filter(self) -> str: ...

def initialize_platform() -> None: ...
def qwen_platform() -> tuple[str, str]: ...

class ParsedSegment:
    @property
    def text(self) -> str: ...
    @property
    def speed(self) -> float | None: ...
    @property
    def pitch(self) -> float | None: ...
    @property
    def volume(self) -> float | None: ...
    @property
    def speaker_id(self) -> int | None: ...
    @property
    def echo(self) -> int | None: ...
    @property
    def yamabiko(self) -> int | None: ...
    @property
    def panning(self) -> str | None: ...
    @property
    def action(self) -> str | None: ...
    @property
    def word(self) -> str | None: ...
    @property
    def reading(self) -> str | None: ...

class DictionarySnapshot:
    @property
    def revision(self) -> int: ...
    def replace(self, text: str) -> str: ...

class DictionaryDatabase:
    def __init__(self, path: str) -> None: ...
    def snapshot(self) -> DictionarySnapshot: ...
    def begin(self) -> int: ...
    def groups(self, draft: int) -> list[tuple[int, str, int, int]]: ...
    def page(
        self, draft: int, group: int, offset: int, limit: int
    ) -> tuple[int, list[tuple[int, int, str, str, str, str]]]: ...
    def add_group(self, draft: int, name: str) -> int: ...
    def edit_group(self, draft: int, group: int, name: str | None = ...) -> None: ...
    def append(self, draft: int, group: int) -> int: ...
    def edit(self, draft: int, row: tuple[int, int, str, str, str, str], deleted: bool = ...) -> None: ...
    def import_file(self, draft: int, group: int, path: str) -> int: ...
    def commit(self, draft: int) -> None: ...
    def discard(self, draft: int) -> None: ...
    def educate(self, word: str, reading: str | None = ...) -> None: ...

def parse_comment(text: str) -> list[ParsedSegment]: ...
def split_sentences(text: str) -> list[str]: ...
def hiragana_to_katakana(text: str) -> str: ...
